<Window x:Class="ImeiStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:conv="clr-namespace:ImeiStudio.Converters"
        mc:Ignorable="d"
        Title="Remofix IMEI"
        Icon="Assets/R_white_bg.png"
        Height="840" Width="1360"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.IsIconVisible="True"
        ui:TitleBar.Background="#0F172A"
        ui:TitleBar.Foreground="#FFFFFF"
        ui:TitleBar.InactiveBackground="#0F172A"
        ui:TitleBar.InactiveForeground="#94A3B8">

    <Window.Resources>
        <conv:CategoryToBackgroundConverter x:Key="CatBgConv" />
        <conv:CategoryToForegroundConverter x:Key="CatFgConv" />
        <conv:CategoryToBorderConverter x:Key="CatBorderConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sol Kenar Çubuğu (Sidebar) -->
            <ColumnDefinition Width="280" />
            <!-- Ana İçerik Alanı -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- SOL KENAR ÇUBUĞU (SIDEBAR)                                -->
        <!-- ========================================================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="20,24,20,20">
                <Grid.RowDefinitions>
                    <!-- Logo & Başlık -->
                    <RowDefinition Height="Auto" />
                    <!-- Ayırıcı Çizgi -->
                    <RowDefinition Height="Auto" />
                    <!-- Menü Butonları -->
                    <RowDefinition Height="*" />
                    <!-- İstatistik Özeti -->
                    <RowDefinition Height="Auto" />
                    <!-- Tema Değiştirici Butonu -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo & Başlık: Remofix IMEI -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="10" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.06" />
                            </Border.Effect>
                            <Image Source="Assets/R.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Remofix IMEI" FontWeight="Bold" FontSize="19" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Ayırıcı Çizgi -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource SidebarBorderBrush}" Margin="0,0,0,20" />

                <!-- Menü Öğeleri -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="İŞLEM MODÜLLERİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,10" />

                    <!-- Tekli Sorgu -->
                    <RadioButton Style="{DynamicResource SidebarNavButtonStyle}"
                                 IsChecked="True"
                                 Click="Nav_SingleQuery_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Tekli IMEI Sorgulama" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Toplu Sorgu -->
                    <RadioButton Style="{DynamicResource SidebarNavButtonStyle}"
                                 Click="Nav_BulkQuery_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Toplu IMEI Sorgulama" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- IMEI Üretici -->
                    <RadioButton Style="{DynamicResource SidebarNavButtonStyle}"
                                 Click="Nav_Generator_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="IMEI Üretici" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- IMEI Kasası -->
                    <RadioButton Style="{DynamicResource SidebarNavButtonStyle}"
                                 Click="Nav_Vault_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="IMEI Kasası" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Alt Durum Kartı (İstatistik) -->
                <Border Grid.Row="3" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Kayıtlı Havuzu" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding CountTotalVault}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryNavyBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Kullanılabilir" FontSize="11" Foreground="#10B981" />
                                <TextBlock Text="{Binding CountUsable}" FontWeight="Bold" FontSize="15" Foreground="#10B981" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Kullanılan" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding CountUsed}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tema Değiştirici Buton -->
                <Button Grid.Row="4"
                        x:Name="btnThemeToggle"
                        Style="{DynamicResource SidebarThemeButtonStyle}"
                        Click="BtnThemeToggle_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- İkon -->
                        <TextBlock Grid.Column="0"
                                   x:Name="txtThemeIcon"
                                   Text="🌙"
                                   FontSize="15"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />

                        <!-- Metin -->
                        <TextBlock Grid.Column="1"
                                   x:Name="txtThemeTitle"
                                   Text="Koyu Tema"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- Modern Switch Göstergesi -->
                        <Border Grid.Column="2"
                                x:Name="borderToggleTrack"
                                Width="36"
                                Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource PrimaryNavyBrush}"
                                VerticalAlignment="Center"
                                Padding="2">
                            <Ellipse x:Name="toggleThumb"
                                     Width="16"
                                     Height="16"
                                     Fill="#FFFFFF"
                                     HorizontalAlignment="Right" />
                        </Border>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- SAĞ ANA İÇERİK ALANI                                      -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <!-- Üst Başlık Çubuğu -->
                <RowDefinition Height="Auto" />
                <!-- Sayfa İçeriği -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Üst Başlık Çubuğu -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock x:Name="txtPageTitle" Text="Tekli IMEI Sorgulama" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="txtPageSubtitle" Text="14 haneli IMEI girin; 15. Luhn hanesi otomatik hesaplanıp birleştirilerek sorgulanır." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- ===================================================== -->
            <!-- 1. SAYFA: TEKLİ IMEI SORGULAMA                        -->
            <!-- ===================================================== -->
            <Grid x:Name="panelSingleQuery" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Giriş Kartı -->
                <Border Grid.Row="0" Style="{DynamicResource ModernCardStyle}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="IMEI Numarası (İlk 14 Hane)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- 14 Hane Giriş -->
                                <ColumnDefinition Width="*" />
                                <!-- 15. Hane Luhn Rozeti -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Butonlar -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 14 Hanelik TextBox (Sadece Rakam & Max 14) -->
                            <TextBox Grid.Column="0"
                                     x:Name="txtSingle14"
                                     Text="{Binding SingleImei14, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Padding="14,10"
                                     Height="48"
                                     MaxLength="14"
                                     VerticalContentAlignment="Center"
                                     ui:ControlHelper.CornerRadius="8"
                                     ui:ControlHelper.PlaceholderText="14 haneli numara yazın (Örn: 35419609146806)"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"
                                     KeyDown="SingleImeiTextBox_KeyDown" />

                            <!-- 15. Luhn Hanesi Göstergesi -->
                            <Border Grid.Column="1"
                                    Width="56" Height="48"
                                    Background="{DynamicResource SubCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Margin="10,0,0,0"
                                    ToolTip="Luhn Algoritması ile Otomatik Hesaplanan 15. Kontrol Hanesi">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="LUHN" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SingleCheckDigit}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryNavyBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="2"
                                    Content="📋 Yapıştır"
                                    Style="{DynamicResource SecondaryActionButtonStyle}"
                                    Height="48"
                                    Margin="12,0,0,0"
                                    Click="BtnPasteSingle_Click" />

                            <Button Grid.Column="3"
                                    Content="🔍 Sorgula"
                                    Style="{DynamicResource PrimaryActionButtonStyle}"
                                    Height="48"
                                    Margin="12,0,0,0"
                                    Click="BtnQuerySingle_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Sonuç Kartı -->
                <Border Grid.Row="1" Style="{DynamicResource ModernCardStyle}">
                    <Grid DataContext="{Binding LastSingleResult}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Üst Rozet & Durum -->
                        <Border Grid.Row="0"
                                Background="{Binding Category, Converter={StaticResource CatBgConv}}"
                                BorderBrush="{Binding Category, Converter={StaticResource CatBorderConv}}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{Binding Category, Converter={StaticResource CatFgConv}}" />
                                    <TextBlock Text="{Binding BrandModel}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SubCardBackgroundBrush}"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{Binding Category, Converter={StaticResource CatFgConv}}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Detay Kartları -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TAM IMEI (15 HANE)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Imei}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="KAYNAK KURUM" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Source}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="SORGU ZAMANI" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding QueryDate, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Eylemler -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="💾 IMEI Kasasına Kaydet"
                                    Style="{DynamicResource PrimaryActionButtonStyle}"
                                    Margin="0,0,10,0"
                                    Click="BtnSaveSingleToVault_Click" />
                            <Button Content="📋 Kopyala"
                                    Style="{DynamicResource SecondaryActionButtonStyle}"
                                    Click="BtnCopyImei_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- 2. SAYFA: TOPLU IMEI SORGULAMA                        -->
            <!-- ===================================================== -->
            <Grid x:Name="panelBulkQuery" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Giriş ve Kontrol Kartı -->
                <Border Grid.Row="0" Style="{DynamicResource ModernCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Toplu IMEI Girişi (Her 15 hanede otomatik alt satıra geçer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     x:Name="txtBulkInput"
                                     Text="{Binding BulkInputText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="110"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Courier New, monospace"
                                     FontSize="14"
                                     ui:ControlHelper.CornerRadius="8"
                                     ui:ControlHelper.PlaceholderText="15 haneli IMEI numaralarını yazın veya yapıştırın..."
                                     PreviewTextInput="BulkNumericOnly_PreviewTextInput"
                                     TextChanged="BulkInput_TextChanged" />

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button Content="⚡ Toplu Sorgula"
                                        Style="{DynamicResource PrimaryActionButtonStyle}"
                                        Height="44"
                                        Margin="0,0,0,8"
                                        Click="BtnStartBulk_Click" />
                                <Button Content="Temizle"
                                        Style="{DynamicResource SecondaryActionButtonStyle}"
                                        Height="40"
                                        Click="BtnClearBulk_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- İlerleme Çubuğu Kartı -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding BulkStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding BulkProgressPercentage, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryNavyBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Height="8" Value="{Binding BulkProgressPercentage}" Maximum="100" Background="{DynamicResource SubCardBackgroundBrush}" Foreground="{DynamicResource PrimaryNavyBrush}" ui:ControlHelper.CornerRadius="4" />
                    </StackPanel>
                </Border>

                <!-- Sonuç Tablosu -->
                <Border Grid.Row="2" Style="{DynamicResource ModernCardStyle}" Padding="0" Margin="0,0,0,16">
                    <DataGrid ItemsSource="{Binding BulkResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource DataGridGridLines}"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="42"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IMEI Numarası" Binding="{Binding Imei}" Width="190" ElementStyle="{DynamicResource DgSemiBoldPrimaryText}" />
                            <DataGridTemplateColumn Header="Kayıt Durumu" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Category, Converter={StaticResource CatBgConv}}"
                                                BorderBrush="{Binding Category, Converter={StaticResource CatBorderConv}}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding Category, Converter={StaticResource CatFgConv}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Detay Açıklama" Binding="{Binding Status}" Width="*" ElementStyle="{DynamicResource DgRegularPrimaryText}" />
                            <DataGridTextColumn Header="Marka / Model" Binding="{Binding BrandModel}" Width="180" ElementStyle="{DynamicResource DgSecondaryText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Alt Buton: Sorgulama Bitince Aktif Olan Kaydet Butonu -->
                <Grid Grid.Row="3">
                    <Button Content="💾 Sadece Kayıtlı Olan IMEI'leri Kasaya Kaydet"
                            Style="{DynamicResource SuccessActionButtonStyle}"
                            Height="46"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding IsBulkFinished}"
                            Click="BtnSaveRegisteredBulk_Click" />
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- 3. SAYFA: IMEI ÜRETİCİ (Luhn Algoritması)              -->
            <!-- ===================================================== -->
            <Grid x:Name="panelGenerator" Grid.Row="1" Visibility="Collapsed">
                <Border Style="{DynamicResource ModernCardStyle}">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="IMEI Prefix / TAC Numarası (En fazla 15 hane)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding GenPrefix, UpdateSourceTrigger=PropertyChanged}"
                                 Height="46"
                                 FontSize="15"
                                 MaxLength="15"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 ui:ControlHelper.CornerRadius="8"
                                 Margin="0,0,0,16"
                                 PreviewTextInput="NumericOnly_PreviewTextInput" />

                        <TextBlock Text="Üretilecek Adet Seçimi" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <!-- Sadece 10, 50, 100 Seçenekleri -->
                        <ComboBox SelectedIndex="2"
                                  Height="46"
                                  ui:ControlHelper.CornerRadius="8"
                                  Margin="0,0,0,16"
                                  SelectionChanged="GenCountCombo_SelectionChanged">
                            <ComboBoxItem Content="10 Adet" Tag="10" />
                            <ComboBoxItem Content="50 Adet" Tag="50" />
                            <ComboBoxItem Content="100 Adet" Tag="100" />
                        </ComboBox>

                        <TextBlock Text="Hesaplama Yöntemi" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,24">
                            <TextBlock Text="14 haneli baz numara birer artırılarak 15. hane Luhn algoritmasıyla hesaplanır." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <Button Content="⚙️ IMEI'leri Üret"
                                Style="{DynamicResource PrimaryActionButtonStyle}"
                                Height="48"
                                Click="BtnGenerateImeis_Click" />

                        <Border Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,16">
                            <TextBlock Text="{Binding GenLogMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <!-- Üretim Tamamlandıktan Sonra Aktif Olan Buton -->
                        <Button Content="⚡ Toplu Sorguya Gönder"
                                Style="{DynamicResource SecondaryActionButtonStyle}"
                                Height="46"
                                IsEnabled="{Binding CanSendGenToBulk}"
                                Click="BtnSendToBulk_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- 4. SAYFA: IMEI KASASI                                 -->
            <!-- ===================================================== -->
            <Grid x:Name="panelVault" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- Üst Sekmeler (Kullanılabilir / Kullanılan) ve Arama -->
                    <RowDefinition Height="Auto" />
                    <!-- Tablo -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Üst Kontrol Çubuğu -->
                <Border Grid.Row="0" Style="{DynamicResource ModernCardStyle}" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- İç Sekmeler -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Arama -->
                            <ColumnDefinition Width="*" />
                            <!-- Dışa Aktar -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 2 İç Sekme Butonları -->
                        <Border Grid.Column="0" Background="{DynamicResource SubTabBgBrush}" CornerRadius="10" Padding="4" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Kullanılabilir"
                                             Style="{DynamicResource SubTabButtonStyle}"
                                             IsChecked="True"
                                             Click="SubTab_Usable_Click" />
                                <RadioButton Content="Kullanılanlar"
                                             Style="{DynamicResource SubTabButtonStyle}"
                                             Click="SubTab_Used_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Arama Kutusu -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding VaultSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 ui:ControlHelper.CornerRadius="8"
                                 ui:ControlHelper.PlaceholderText="IMEI, Model veya Not Ara..."
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,0" />

                        <!-- Dışa Aktar Butonu -->
                        <Button Grid.Column="2"
                                Content="💾 TXT Olarak Dışa Aktar"
                                Style="{DynamicResource SecondaryActionButtonStyle}"
                                Height="42"
                                Click="BtnExportVault_Click" />
                    </Grid>
                </Border>

                <!-- ================================================= -->
                <!-- KULLANILABİLİR LİSTESİ TABLOSU                    -->
                <!-- ================================================= -->
                <Border x:Name="borderUsableVault" Grid.Row="1" Style="{DynamicResource ModernCardStyle}" Padding="0" Visibility="Visible">
                    <DataGrid ItemsSource="{Binding UsableRecords}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource DataGridGridLines}"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="46"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kayıtlı IMEI" Binding="{Binding Imei}" Width="190" ElementStyle="{DynamicResource DgBoldPrimaryText}" />
                            <DataGridTextColumn Header="Model Bilgisi" Binding="{Binding BrandModel}" Width="200" ElementStyle="{DynamicResource DgSecondaryText}" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="*" ElementStyle="{DynamicResource DgRegularPrimaryText}" />
                            <DataGridTextColumn Header="Eklenme Zamanı" Binding="{Binding QueryDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140" ElementStyle="{DynamicResource DgMutedText}" />

                            <!-- Eylem Butonları: Kopyala, Kullanıldı, Sil -->
                            <DataGridTemplateColumn Header="İşlemler" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Kopyala"
                                                    Style="{DynamicResource TableActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="VaultAction_Copy_Click" />
                                            <Button Content="Kullanıldı"
                                                    Style="{DynamicResource TableActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="VaultAction_MarkUsed_Click" />
                                            <Button Content="Sil"
                                                    Style="{DynamicResource DangerActionButtonStyle}"
                                                    Click="VaultAction_Delete_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ================================================= -->
                <!-- KULLANILANLAR LİSTESİ TABLOSU                     -->
                <!-- ================================================= -->
                <Border x:Name="borderUsedVault" Grid.Row="1" Style="{DynamicResource ModernCardStyle}" Padding="0" Visibility="Collapsed">
                    <DataGrid ItemsSource="{Binding UsedRecords}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource DataGridGridLines}"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="46"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kullanılan IMEI" Binding="{Binding Imei}" Width="180" ElementStyle="{DynamicResource DgBoldPrimaryText}" />
                            <DataGridTextColumn Header="Model Bilgisi" Binding="{Binding BrandModel}" Width="180" ElementStyle="{DynamicResource DgSecondaryText}" />
                            <DataGridTextColumn Header="Özel Not" Binding="{Binding Note}" Width="*" ElementStyle="{DynamicResource DgNoteText}" />
                            <DataGridTextColumn Header="İşlem Tarihi" Binding="{Binding QueryDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="130" ElementStyle="{DynamicResource DgMutedText}" />

                            <!-- Eylemler: Kopyala, Geri Yükle, Not Ekle, Sil -->
                            <DataGridTemplateColumn Header="İşlemler" Width="290">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Kopyala"
                                                    Style="{DynamicResource TableActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="VaultAction_Copy_Click" />
                                            <Button Content="Geri Yükle"
                                                    Style="{DynamicResource TableActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="VaultAction_Restore_Click" />
                                            <Button Content="Not Ekle"
                                                    Style="{DynamicResource TableActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="VaultAction_AddNote_Click" />
                                            <Button Content="Sil"
                                                    Style="{DynamicResource DangerActionButtonStyle}"
                                                    Click="VaultAction_Delete_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </Grid>

        </Grid>

        <!-- Modern Floating Toast Notification Overlay -->
        <Border x:Name="toastBorder"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,32,32"
                MinWidth="320"
                MaxWidth="440"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Visibility="Collapsed"
                Opacity="0"
                Panel.ZIndex="9999">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.30" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border x:Name="toastIconBorder"
                        Grid.Column="0"
                        Width="34" Height="34"
                        CornerRadius="8"
                        Background="#064E3B"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="txtToastIcon"
                               Text="✓"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#34D399"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Text Content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="txtToastTitle"
                               Text="İşlem Başarılı"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#FFFFFF" />
                    <TextBlock x:Name="txtToastMessage"
                               Text="Açıklama mesajı"
                               FontSize="12"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2"
                        Content="✕"
                        Foreground="#64748B"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="11"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Padding="6"
                        VerticalAlignment="Top"
                        Click="ToastClose_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
