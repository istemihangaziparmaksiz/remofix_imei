<Window x:Class="ImeiStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:conv="clr-namespace:ImeiStudio.Converters"
        mc:Ignorable="d"
        Title="Remofix IMEI"
        Icon="Assets/R_white_bg.png"
        Height="850" Width="1380"
        MinHeight="720" MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.IsIconVisible="True"
        ui:TitleBar.Background="#09090B"
        ui:TitleBar.Foreground="#FAFAFA"
        ui:TitleBar.InactiveBackground="#09090B"
        ui:TitleBar.InactiveForeground="#71717A">

    <Window.Resources>
        <conv:CategoryToBackgroundConverter x:Key="CatBgConv" />
        <conv:CategoryToForegroundConverter x:Key="CatFgConv" />
        <conv:CategoryToBorderConverter x:Key="CatBorderConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sol Mimari Kenar Çubuğu -->
            <ColumnDefinition Width="268" />
            <!-- Ana Çalışma Alanı -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- SOL KENAR ÇUBUĞU (SIDEBAR)                                -->
        <!-- ========================================================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo & Marka Başlığı -->
                <Grid Grid.Row="0" Margin="2,0,2,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="38" Height="38"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E4E7"
                            BorderThickness="1"
                            Padding="4">
                        <Image Source="Assets/R.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Remofix IMEI"
                                   FontWeight="Bold"
                                   FontSize="16.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="TELECOM WORKBENCH"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>

                <!-- İnce Ayırıcı Çizgi -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource SidebarBorderBrush}" Margin="0,0,0,18" />

                <!-- Navigasyon Modülleri -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="ÇALIŞMA ALANI"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="8,0,0,8" />

                    <!-- 1. Tekli Sorgu -->
                    <RadioButton x:Name="rbNavSingle"
                                 Style="{DynamicResource SidebarNavButtonStyle}"
                                 IsChecked="True"
                                 Click="Nav_SingleQuery_Click">
                        <Grid Width="210">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoSearch}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Width="15" Height="15"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Tekli IMEI Sorgulama" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <!-- 2. Toplu Sorgu -->
                    <RadioButton x:Name="rbNavBulk"
                                 Style="{DynamicResource SidebarNavButtonStyle}"
                                 Click="Nav_BulkQuery_Click">
                        <Grid Width="210">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoLayers}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="15" Height="15"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Toplu IMEI Sorgulama" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <!-- 3. IMEI Üretici -->
                    <RadioButton x:Name="rbNavGen"
                                 Style="{DynamicResource SidebarNavButtonStyle}"
                                 Click="Nav_Generator_Click">
                        <Grid Width="210">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoCpu}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="15" Height="15"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="IMEI Üretici" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <!-- 4. IMEI Kasası -->
                    <RadioButton x:Name="rbNavVault"
                                 Style="{DynamicResource SidebarNavButtonStyle}"
                                 Click="Nav_Vault_Click">
                        <Grid Width="210">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoVault}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="15" Height="15"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="IMEI Kasası" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding CountUsable}"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <!-- Alt Envanter Telemetri Kartı -->
                <Border Grid.Row="3"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="14,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="YEREL KASA ENVANTERİ"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AKTİF" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding CountUsable}"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#10B981"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="KULLANILAN" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding CountUsed}"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TOPLAM" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding CountTotalVault}"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PIN Kilidi Ayarları Butonu -->
                <Button Grid.Row="4"
                        Style="{DynamicResource SidebarThemeButtonStyle}"
                        Margin="0,10,0,0"
                        Click="BtnPinSettings_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Data="{StaticResource GeoLock}"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Width="14" Height="14"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="PIN Kilidi"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <Border Grid.Column="2"
                                x:Name="borderPinStatusBadge"
                                Background="{DynamicResource SubCardBackgroundBrush}"
                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="txtPinStatusBadge"
                                       Text="KAPALI"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Tema Değiştirici Buton -->
                <Button Grid.Row="5"
                        x:Name="btnThemeToggle"
                        Style="{DynamicResource SidebarThemeButtonStyle}"
                        Margin="0,8,0,0"
                        Click="BtnThemeToggle_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              x:Name="pathThemeIcon"
                              Data="{StaticResource GeoMoon}"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Width="14" Height="14"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   x:Name="txtThemeTitle"
                                   Text="Koyu Görünüm"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- Minimalist Switch Göstergesi -->
                        <Border Grid.Column="2"
                                x:Name="borderToggleTrack"
                                Width="34"
                                Height="18"
                                CornerRadius="9"
                                Background="#27272A"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Padding="2">
                            <Ellipse x:Name="toggleThumb"
                                     Width="12"
                                     Height="12"
                                     Fill="#FAFAFA"
                                     HorizontalAlignment="Right" />
                        </Border>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- SAĞ ANA İÇERİK ALANI                                      -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <!-- Üst Başlık ve Sistem Durum Çubuğu -->
                <RowDefinition Height="Auto" />
                <!-- Sayfa İçeriği -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Üst Başlık Çubuğu -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="txtPageTitle"
                               Text="Tekli IMEI Sorgulama"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="txtPageSubtitle"
                               Text="14 haneli IMEI girin; 15. Luhn hanesi otomatik hesaplanıp birleştirilerek sorgulanır."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Sağ Üst Sistem Durum Rozeti -->
                <Border Grid.Column="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,7"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="BTK / e-Devlet Motoru Hazır"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="12" Background="{DynamicResource CardBorderBrush}" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="AES-256"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- 1. SAYFA: TEKLİ IMEI SORGULAMA                        -->
            <!-- ===================================================== -->
            <Grid x:Name="panelSingleQuery" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Giriş Kartı -->
                <Border Grid.Row="0" Style="{DynamicResource ModernCardStyle}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="IMEI NUMARASI (İLK 14 HANE)"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SingleQueryStatusText}"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- 14 Hane Giriş -->
                                <ColumnDefinition Width="*" />
                                <!-- 15. Hane Luhn Rozeti -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Butonlar -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 14 Hanelik Monospace TextBox -->
                            <TextBox Grid.Column="0"
                                     x:Name="txtSingle14"
                                     Text="{Binding SingleImei14, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Cascadia Mono, Consolas, monospace"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Padding="14,0"
                                     Height="46"
                                     MaxLength="14"
                                     VerticalContentAlignment="Center"
                                     ui:ControlHelper.CornerRadius="7"
                                     ui:ControlHelper.PlaceholderText="14 haneli IMEI numarasını yazın..."
                                     PreviewTextInput="NumericOnly_PreviewTextInput"
                                     KeyDown="SingleImeiTextBox_KeyDown" />

                            <!-- 15. Luhn Hanesi Donanımsal Gösterge -->
                            <Border Grid.Column="1"
                                    Width="68" Height="46"
                                    Background="{DynamicResource SubCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Margin="8,0,0,0"
                                    ToolTip="ISO/IEC 7812 Luhn Algoritması ile Hesaplanan 15. Kontrol Hanesi">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="15. HANE"
                                               FontFamily="Cascadia Mono, Consolas, monospace"
                                               FontSize="8.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SingleCheckDigit}"
                                               FontFamily="Cascadia Mono, Consolas, monospace"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#10B981"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Yapıştır Butonu -->
                            <Button Grid.Column="2"
                                    Style="{DynamicResource SecondaryActionButtonStyle}"
                                    Height="46"
                                    Padding="16,0"
                                    Margin="10,0,0,0"
                                    Click="BtnPasteSingle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoPaste}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Yapıştır" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Sorgula Butonu -->
                            <Button Grid.Column="3"
                                    Style="{DynamicResource PrimaryActionButtonStyle}"
                                    Height="46"
                                    Padding="22,0"
                                    Margin="10,0,0,0"
                                    IsEnabled="{Binding IsSingleQueryBusy, Converter={StaticResource BoolToVis}, FallbackValue=True}"
                                    Click="BtnQuerySingle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoSearch}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Sorgula" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Sonuç Spesifikasyon Kartı -->
                <Border Grid.Row="1" Style="{DynamicResource ModernCardStyle}">
                    <Grid DataContext="{Binding LastSingleResult}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="SORGU SONUÇ RAPORU"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Üst Rozet & Durum -->
                        <Border Grid.Row="1"
                                Background="{Binding Category, Converter={StaticResource CatBgConv}}"
                                BorderBrush="{Binding Category, Converter={StaticResource CatBorderConv}}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18,16"
                                Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Status, TargetNullValue='Henüz sorgulama yapılmadı'}"
                                               FontSize="16.5"
                                               FontWeight="Bold"
                                               Foreground="{Binding Category, Converter={StaticResource CatFgConv}}" />
                                    <TextBlock Text="{Binding BrandModel, TargetNullValue='Sorgulama sonucunda cihaz marka ve model bilgisi burada görüntülenir.'}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{Binding Category, Converter={StaticResource CatBorderConv}}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category, TargetNullValue='BEKLİYOR'}"
                                               FontFamily="Cascadia Mono, Consolas, monospace"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="{Binding Category, Converter={StaticResource CatFgConv}}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 3 Sütunlu Teknik Spesifikasyon Kartları -->
                        <Grid Grid.Row="2" Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="TAM IMEI (15 HANE)" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Imei, TargetNullValue='—'}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="6,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="DOĞRULAMA KAYNAĞI" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Source, TargetNullValue='BTK / e-Devlet'}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="SORGU ZAMANI" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding QueryDate, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}', TargetNullValue='—'}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Eylem Butonları -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{DynamicResource PrimaryActionButtonStyle}"
                                    Height="40"
                                    Padding="18,0"
                                    Margin="0,0,10,0"
                                    Click="BtnSaveSingleToVault_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoVault}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="IMEI Kasasına Kaydet" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource SecondaryActionButtonStyle}"
                                    Height="40"
                                    Padding="16,0"
                                    Click="BtnCopyImei_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoCopy}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="IMEI Kopyala" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- 2. SAYFA: TOPLU IMEI SORGULAMA                        -->
            <!-- ===================================================== -->
            <Grid x:Name="panelBulkQuery" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Giriş ve Kontrol Kartı -->
                <Border Grid.Row="0" Style="{DynamicResource ModernCardStyle}" Padding="20" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="TOPLU IMEI LİSTESİ"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Her 15 hanede otomatik alt satıra geçer"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="210" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     x:Name="txtBulkInput"
                                     Text="{Binding BulkInputText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="100"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas, monospace"
                                     FontSize="13.5"
                                     Padding="12,10"
                                     ui:ControlHelper.CornerRadius="7"
                                     ui:ControlHelper.PlaceholderText="15 haneli IMEI numaralarını alt alta yazın veya yapıştırın..."
                                     PreviewTextInput="BulkNumericOnly_PreviewTextInput"
                                     TextChanged="BulkInput_TextChanged" />

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Button Style="{DynamicResource PrimaryActionButtonStyle}"
                                        Height="44"
                                        Margin="0,0,0,8"
                                        Click="BtnStartBulk_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoLayers}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"
                                              Width="14" Height="14"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Toplu Sorgula" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{DynamicResource SecondaryActionButtonStyle}"
                                        Height="40"
                                        Click="BtnClearBulk_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoTrash}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"
                                              Width="13" Height="13"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Listeyi Temizle" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Hedef Bulunca Otomatik Durdurma Barı -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource SubCardBackgroundBrush}"
                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,8"
                                Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding BulkAutoStopEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0">
                                    <TextBlock Text="Hedef Bulunca Otomatik Durdur:"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </CheckBox>
                                <TextBox Text="{Binding BulkAutoStopTarget, UpdateSourceTrigger=PropertyChanged}"
                                         Width="64"
                                         Height="30"
                                         FontFamily="Cascadia Mono, Consolas, monospace"
                                         FontSize="13"
                                         FontWeight="Bold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         ui:ControlHelper.CornerRadius="5"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                         Margin="0,0,8,0" />
                                <TextBlock Text="adet KAYITLI IMEI bulunduğunda sorguyu otomatik durdur ve kasaya kaydet."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- İlerleme Çubuğu ve Duraklat / Durdur Kontrol Kartı -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding BulkStatusMessage}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,14,0">
                                <Button Content="{Binding BulkPauseButtonText}"
                                        Style="{DynamicResource TableActionButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        Margin="0,0,6,0"
                                        IsEnabled="{Binding IsBulkQueryBusy}"
                                        Click="BtnPauseBulk_Click" />
                                <Button Content="Durdur"
                                        Style="{DynamicResource DangerActionButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        IsEnabled="{Binding IsBulkQueryBusy}"
                                        Click="BtnStopBulk_Click" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding BulkProgressPercentage, StringFormat='{}{0}%'}"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#10B981"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Height="5" Value="{Binding BulkProgressPercentage}" Maximum="100" Background="{DynamicResource SubCardBackgroundBrush}" Foreground="#10B981" ui:ControlHelper.CornerRadius="2.5" />
                    </StackPanel>
                </Border>

                <!-- Sonuç Tablosu -->
                <Border Grid.Row="2" Style="{DynamicResource ModernCardStyle}" Padding="0" Margin="0,0,0,14">
                    <DataGrid ItemsSource="{Binding BulkResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource DataGridGridLines}"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="42"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IMEI NUMARASI" Binding="{Binding Imei}" Width="195" ElementStyle="{DynamicResource DgSemiBoldPrimaryText}" />
                            <DataGridTemplateColumn Header="KAYIT DURUMU" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Category, Converter={StaticResource CatBgConv}}"
                                                BorderBrush="{Binding Category, Converter={StaticResource CatBorderConv}}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category}"
                                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding Category, Converter={StaticResource CatFgConv}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DETAY AÇIKLAMA" Binding="{Binding Status}" Width="*" ElementStyle="{DynamicResource DgRegularPrimaryText}" />
                            <DataGridTextColumn Header="MARKA / MODEL" Binding="{Binding BrandModel}" Width="190" ElementStyle="{DynamicResource DgSecondaryText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Alt Buton: Sorgulama Bitince Aktif Olan Kaydet Butonu -->
                <Grid Grid.Row="3">
                    <Button Style="{DynamicResource SuccessActionButtonStyle}"
                            Height="42"
                            Padding="20,0"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding IsBulkFinished}"
                            Click="BtnSaveRegisteredBulk_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoCheck}"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Sadece Kayıtlı Olan IMEI'leri Kasaya Kaydet" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- 3. SAYFA: IMEI ÜRETİCİ (Luhn Algoritması)              -->
            <!-- ===================================================== -->
            <Grid x:Name="panelGenerator" Grid.Row="1" Visibility="Collapsed">
                <Border Style="{DynamicResource ModernCardStyle}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Sol Sütun: Parametreler -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ÜRETİM PARAMETRELERİ"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,14" />

                            <TextBlock Text="Başlangıç IMEI Numarası (İlk 14 Hane)"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding GenPrefix, UpdateSourceTrigger=PropertyChanged}"
                                     Height="44"
                                     FontFamily="Cascadia Mono, Consolas, monospace"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     MaxLength="15"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     ui:ControlHelper.CornerRadius="7"
                                     Margin="0,0,0,16"
                                     PreviewTextInput="NumericOnly_PreviewTextInput" />

                            <TextBlock Text="Üretilecek Seri Adedi"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,6" />
                            <ComboBox SelectedIndex="2"
                                      Height="44"
                                      HorizontalAlignment="Stretch"
                                      ui:ControlHelper.CornerRadius="7"
                                      Margin="0,0,0,22"
                                      SelectionChanged="GenCountCombo_SelectionChanged">
                                <ComboBoxItem Content="10 Adet" Tag="10" />
                                <ComboBoxItem Content="50 Adet" Tag="50" />
                                <ComboBoxItem Content="100 Adet" Tag="100" />
                            </ComboBox>

                            <Button Style="{DynamicResource PrimaryActionButtonStyle}"
                                    Height="44"
                                    HorizontalAlignment="Stretch"
                                    Click="BtnGenerateImeis_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoCpu}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="IMEI Serisini Üret" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Sağ Sütun: Durum ve Aktarım -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                            <TextBlock Text="ALGORİTMA &amp; ÇIKTI DURUMU"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,14" />

                            <Border Background="{DynamicResource SubCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ISO/IEC 7812 Luhn Mod-10 Standardı"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="14 haneli baz numara ardışık olarak birer artırılarak 15. kontrol basamağı matematiksel Luhn toplamıyla doğrulanır."
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SubCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="DURUM GÜNLÜĞÜ"
                                               FontFamily="Cascadia Mono, Consolas, monospace"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding GenLogMessage}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Button Style="{DynamicResource SecondaryActionButtonStyle}"
                                    Height="44"
                                    HorizontalAlignment="Left"
                                    Padding="20,0"
                                    IsEnabled="{Binding CanSendGenToBulk}"
                                    Click="BtnSendToBulk_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Toplu Sorguya Aktar" VerticalAlignment="Center" />
                                    <Path Data="{StaticResource GeoArrowRight}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- 4. SAYFA: IMEI KASASI                                 -->
            <!-- ===================================================== -->
            <Grid x:Name="panelVault" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- Üst Sekmeler, Arama ve Aksiyonlar -->
                    <RowDefinition Height="Auto" />
                    <!-- İlerleme Çubuğu (Kontrol Sırasında Görünür) -->
                    <RowDefinition Height="Auto" />
                    <!-- Tablo -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Üst Kontrol ve Çoklu Seçim Çubuğu -->
                <Border Grid.Row="0" Style="{DynamicResource ModernCardStyle}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- 1. Satır: Sekmeler, Arama, Manuel Ekle, Kontrol Et, TXT -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- İç Sekmeler -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Arama -->
                                <ColumnDefinition Width="*" />
                                <!-- Manuel Ekle -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Kontrol Et -->
                                <ColumnDefinition Width="Auto" />
                                <!-- İçe Aktar -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Dışa Aktar -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Segmented Sekme Butonları -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource SubTabBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="3"
                                    Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbSubTabUsable"
                                                 Content="Kullanılabilir"
                                                 Style="{DynamicResource SubTabButtonStyle}"
                                                 IsChecked="True"
                                                 Click="SubTab_Usable_Click" />
                                    <RadioButton x:Name="rbSubTabUsed"
                                                 Content="Kullanılanlar"
                                                 Style="{DynamicResource SubTabButtonStyle}"
                                                 Click="SubTab_Used_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Arama Kutusu -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding VaultSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="38"
                                     ui:ControlHelper.CornerRadius="7"
                                     ui:ControlHelper.PlaceholderText="IMEI, müşteri, cihaz veya not ara..."
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0" />

                            <!-- + Manuel IMEI Ekle Butonu -->
                            <Button Grid.Column="2"
                                    Style="{DynamicResource SecondaryActionButtonStyle}"
                                    Height="38"
                                    Padding="13,0"
                                    Margin="0,0,8,0"
                                    ToolTip="e-Devlet sorgusu yapmadan doğrudan kasaya kayıtlı IMEI ekle"
                                    Click="BtnManualAddVault_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoPlus}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="Uniform"
                                          Width="12" Height="12"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Manuel Ekle" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Kontrol Et / Seçilileri Kontrol Et Butonu -->
                            <Button Grid.Column="3"
                                    Style="{DynamicResource PrimaryActionButtonStyle}"
                                    Height="38"
                                    Padding="15,0"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanCheckVault}"
                                    Click="BtnCheckVault_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoRefresh}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="13" Height="13"
                                          Margin="0,0,7,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CheckVaultButtonText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- TXT İçe Aktar Butonu -->
                            <Button Grid.Column="4"
                                    Style="{DynamicResource SecondaryActionButtonStyle}"
                                    Height="38"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Click="BtnImportVault_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoDownload}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="13" Height="13"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="İçe Aktar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- TXT Dışa Aktar Butonu -->
                            <Button Grid.Column="5"
                                    Style="{DynamicResource SecondaryActionButtonStyle}"
                                    Height="38"
                                    Padding="12,0"
                                    Click="BtnExportVault_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoUpload}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="13" Height="13"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Dışa Aktar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 2. Satır: Çoklu Seçim & Çift SIM Eşleştirme Araç Çubuğu -->
                        <Border Background="{DynamicResource SubCardBackgroundBrush}"
                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,7"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Tümünü Seç / Temizle"
                                            Style="{DynamicResource TableActionButtonStyle}"
                                            Height="26"
                                            Padding="10,0"
                                            Margin="0,0,10,0"
                                            Click="BtnToggleSelectAllVault_Click" />

                                    <TextBlock Text="SEÇİLİ:"
                                               FontFamily="Cascadia Mono, Consolas, monospace"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,1"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedVaultCount}"
                                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="#10B981" />
                                    </Border>
                                    <TextBlock Text="IMEI'lerin solundaki noktaya tıklayarak seçim yapabilirsiniz (2 seçimde Çift SIM aktif olur)."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <!-- Çift SIM Eşleştir & Kullanıldı İşaretle (Tam 2 seçili olduğunda aktif) -->
                                    <Button Style="{DynamicResource TableActionButtonStyle}"
                                            Height="28"
                                            Padding="11,0"
                                            Margin="0,0,6,0"
                                            IsEnabled="{Binding CanPairDualSim}"
                                            Click="BtnPairDualSim_Click"
                                            ToolTip="Kullanılabilir listeden tam 2 IMEI seçtiğinizde aktif olur">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoLink}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Stretch="Uniform"
                                                  Width="12" Height="12"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Çift SIM (SIM 1+2) Kullanıldı İşaretle" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Seçilileri Kopyala -->
                                    <Button Content="Seçilileri Kopyala"
                                            Style="{DynamicResource TableActionButtonStyle}"
                                            Height="28"
                                            Padding="11,0"
                                            Margin="0,0,6,0"
                                            IsEnabled="{Binding HasSelectedVaultItems}"
                                            Click="BtnCopySelectedVault_Click" />

                                    <!-- Seçilileri Sil -->
                                    <Button Content="Seçilileri Sil"
                                            Style="{DynamicResource DangerActionButtonStyle}"
                                            Height="28"
                                            Padding="11,0"
                                            IsEnabled="{Binding HasSelectedVaultItems}"
                                            Click="BtnDeleteSelectedVault_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Kasa Kontrol İlerleme Çubuğu ve Duraklat / Durdur Kartı -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,14"
                        Visibility="{Binding IsVaultCheckBarVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding VaultCheckStatusMessage}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,14,0">
                                <Button Content="{Binding VaultCheckPauseButtonText}"
                                        Style="{DynamicResource TableActionButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        Margin="0,0,6,0"
                                        IsEnabled="{Binding IsVaultCheckBusy}"
                                        Click="BtnPauseVaultCheck_Click" />
                                <Button Content="Durdur"
                                        Style="{DynamicResource DangerActionButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        IsEnabled="{Binding IsVaultCheckBusy}"
                                        Click="BtnStopVaultCheck_Click" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding VaultCheckProgressPercentage, StringFormat='{}{0}%'}"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#10B981"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Height="5"
                                     Value="{Binding VaultCheckProgressPercentage}"
                                     Maximum="100"
                                     Background="{DynamicResource SubCardBackgroundBrush}"
                                     Foreground="#10B981"
                                     ui:ControlHelper.CornerRadius="2.5" />
                    </StackPanel>
                </Border>

                <!-- ================================================= -->
                <!-- KULLANILABİLİR LİSTESİ TABLOSU                    -->
                <!-- ================================================= -->
                <Border x:Name="borderUsableVault" Grid.Row="2" Style="{DynamicResource ModernCardStyle}" Padding="0" Visibility="Visible">
                    <DataGrid x:Name="dgUsableVault"
                              ItemsSource="{Binding UsableRecords}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource DataGridGridLines}"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="46"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <!-- Seçim Noktası + Kayıtlı IMEI + "Kontrol ediliyor..." Rozeti -->
                            <DataGridTemplateColumn Header="KAYITLI IMEI" Width="315">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Seçim Noktası (Sol Seçim Dairesi) -->
                                            <Button Cursor="Hand"
                                                    ToolTip="Bu IMEI'yi seç / seçimi kaldır"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Click="VaultSelectionDot_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Width="20" Height="20" Background="Transparent">
                                                            <!-- Seçili Değilken Boş Halka -->
                                                            <Border Width="18" Height="18"
                                                                    CornerRadius="9"
                                                                    Background="{DynamicResource SubCardBackgroundBrush}"
                                                                    BorderBrush="#52525B"
                                                                    BorderThickness="1.5"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                                            <!-- Seçili Olduğunda Zümrüt Yeşili Dolu Nokta -->
                                                            <Border Width="18" Height="18"
                                                                    CornerRadius="9"
                                                                    Background="#10B981"
                                                                    BorderBrush="#34D399"
                                                                    BorderThickness="1.5"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                                <Ellipse Width="8" Height="8"
                                                                         Fill="#FFFFFF"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <TextBlock Text="{Binding Imei}"
                                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource StatusSuccessBg}"
                                                    BorderBrush="{DynamicResource StatusSuccessBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="5" Height="5" CornerRadius="2.5" Background="#34D399" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Kontrol ediliyor..."
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource StatusSuccessText}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="MODEL BİLGİSİ" Binding="{Binding BrandModel}" Width="185" ElementStyle="{DynamicResource DgSecondaryText}" />

                            <DataGridTemplateColumn Header="DURUM" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{Binding Category, Converter={StaticResource CatBgConv}}"
                                                    BorderBrush="{Binding Category, Converter={StaticResource CatBorderConv}}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}"
                                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Category, Converter={StaticResource CatFgConv}}" />
                                            </Border>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="SON SORGU" Binding="{Binding QueryDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="130" ElementStyle="{DynamicResource DgMutedText}" />

                            <!-- Eylem Butonları: Kopyala, Kullanıldı, Sil -->
                            <DataGridTemplateColumn Header="İŞLEMLER" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Kopyala"
                                                    Style="{DynamicResource TableActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="VaultAction_Copy_Click" />
                                            <Button Content="Kullanıldı"
                                                    Style="{DynamicResource TableActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="VaultAction_MarkUsed_Click" />
                                            <Button Content="Sil"
                                                    Style="{DynamicResource DangerActionButtonStyle}"
                                                    Click="VaultAction_Delete_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ================================================= -->
                <!-- KULLANILANLAR LİSTESİ TABLOSU                     -->
                <!-- ================================================= -->
                <Border x:Name="borderUsedVault" Grid.Row="2" Style="{DynamicResource ModernCardStyle}" Padding="0" Visibility="Collapsed">
                    <DataGrid x:Name="dgUsedVault"
                              ItemsSource="{Binding UsedRecords}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource DataGridGridLines}"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="46"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <!-- Seçim Noktası + Kullanılan IMEI + Çift SIM Rozeti + Kontrol ediliyor Rozeti -->
                            <DataGridTemplateColumn Header="KULLANILAN IMEI" Width="295">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Seçim Noktası (Sol Seçim Dairesi) -->
                                            <Button Cursor="Hand"
                                                    ToolTip="Bu IMEI'yi seç / seçimi kaldır"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Click="VaultSelectionDot_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Width="20" Height="20" Background="Transparent">
                                                            <!-- Seçili Değilken Boş Halka -->
                                                            <Border Width="18" Height="18"
                                                                    CornerRadius="9"
                                                                    Background="{DynamicResource SubCardBackgroundBrush}"
                                                                    BorderBrush="#52525B"
                                                                    BorderThickness="1.5"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                                            <!-- Seçili Olduğunda Zümrüt Yeşili Dolu Nokta -->
                                                            <Border Width="18" Height="18"
                                                                    CornerRadius="9"
                                                                    Background="#10B981"
                                                                    BorderBrush="#34D399"
                                                                    BorderThickness="1.5"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                                <Ellipse Width="8" Height="8"
                                                                         Fill="#FFFFFF"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <TextBlock Text="{Binding Imei}"
                                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                                       FontSize="13.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource SubCardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="7,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{Binding PairedImei, StringFormat='Eşleşen Çift SIM IMEI: {0}'}"
                                                    Visibility="{Binding HasPairedImei, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="ÇİFT SIM"
                                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="#10B981" />
                                            </Border>
                                            <Border Background="{DynamicResource StatusSuccessBg}"
                                                    BorderBrush="{DynamicResource StatusSuccessBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="7,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Kontrol ediliyor..."
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource StatusSuccessText}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="KAYNAK MODEL" Binding="{Binding BrandModel}" Width="145" ElementStyle="{DynamicResource DgSecondaryText}" />

                            <!-- Durum Rozeti (Kullanılanlar yeniden kontrol edildiğinde klon/kayıtlı görünmesi için) -->
                            <DataGridTemplateColumn Header="DURUM" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Category, Converter={StaticResource CatBgConv}}"
                                                BorderBrush="{Binding Category, Converter={StaticResource CatBorderConv}}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="7,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding Status}">
                                            <TextBlock Text="{Binding Category}"
                                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding Category, Converter={StaticResource CatFgConv}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="MÜŞTERİ / CİHAZ / NOT" Binding="{Binding DisplayUsageSummary}" Width="*" ElementStyle="{DynamicResource DgNoteText}" />
                            <DataGridTextColumn Header="İŞLEM TARİHİ" Binding="{Binding EffectiveUsedDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="125" ElementStyle="{DynamicResource DgMutedText}" />

                            <!-- Eylemler: Kopyala, Geri Yükle, Kayıt Düzenle, Sil -->
                            <DataGridTemplateColumn Header="İŞLEMLER" Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Kopyala"
                                                    Style="{DynamicResource TableActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="VaultAction_Copy_Click" />
                                            <Button Content="Geri Yükle"
                                                    Style="{DynamicResource TableActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="VaultAction_Restore_Click" />
                                            <Button Content="Kayıt Düzenle"
                                                    Style="{DynamicResource TableActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="VaultAction_AddNote_Click" />
                                            <Button Content="Sil"
                                                    Style="{DynamicResource DangerActionButtonStyle}"
                                                    Click="VaultAction_Delete_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </Grid>

        </Grid>

        <!-- Modern Floating Toast Notification Overlay -->
        <Border x:Name="toastBorder"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,28"
                MinWidth="320"
                MaxWidth="440"
                Background="#111114"
                BorderBrush="#27272E"
                BorderThickness="1"
                CornerRadius="9"
                Padding="16,12"
                Visibility="Collapsed"
                Opacity="0"
                Panel.ZIndex="9999">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border x:Name="toastIconBorder"
                        Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="7"
                        Background="#052E16"
                        BorderBrush="#065F46"
                        BorderThickness="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="txtToastIcon"
                               Text="✓"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#34D399"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Text Content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="txtToastTitle"
                               Text="İşlem Başarılı"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#FAFAFA" />
                    <TextBlock x:Name="txtToastMessage"
                               Text="Açıklama mesajı"
                               FontSize="12"
                               Foreground="#A1A1AA"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2"
                        Content="✕"
                        Foreground="#71717A"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="11"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Padding="6"
                        VerticalAlignment="Top"
                        Click="ToastClose_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
