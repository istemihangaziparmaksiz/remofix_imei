<Window x:Class="ImeiStudio.UsedImeiDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:conv="clr-namespace:ImeiStudio.Converters"
        Title="Kullanılan IMEI İşlem Detayı"
        Icon="Assets/R_white_bg.png"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Background="#09090B"
        ui:TitleBar.Foreground="#FAFAFA">

    <Window.Resources>
        <conv:CategoryToBackgroundConverter x:Key="CatBgConv" />
        <conv:CategoryToForegroundConverter x:Key="CatFgConv" />
        <conv:CategoryToBorderConverter x:Key="CatBorderConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <!-- Başlık -->
            <RowDefinition Height="Auto" />
            <!-- IMEI ve BTK Kartı -->
            <RowDefinition Height="Auto" />
            <!-- Kullanım & Müşteri Bilgileri Kartı -->
            <RowDefinition Height="Auto" />
            <!-- Alt Butonlar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve İkon -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="42" Height="42"
                    CornerRadius="8"
                    Background="{DynamicResource SubCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <Path Data="{StaticResource GeoVault}"
                      Stroke="{DynamicResource TextPrimaryBrush}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Width="18" Height="18"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Kullanılan IMEI İşlem Detayı"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Bu IMEI numarasına ait donanım, BTK durumu, müşteri ve servis kullanım bilgileri."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- ========================================================= -->
        <!-- 1. KART: IMEI, DONANIM VE BTK DURUMU                      -->
        <!-- ========================================================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource SubCardBackgroundBrush}"
                BorderBrush="{DynamicResource SubCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                Margin="0,0,0,12">
            <StackPanel>
                <!-- IMEI Numarası ve Kopyala Butonu -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="KULLANILAN IMEI NUMARASI"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtImei"
                                       Text="354196091470730"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />

                            <Border x:Name="badgeDualSim"
                                    Background="#064E3B"
                                    BorderBrush="#059669"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="7,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <TextBlock Text="ÇİFT SIM"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#34D399" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="IMEI Kopyala"
                            Style="{DynamicResource TableActionButtonStyle}"
                            Height="30"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Click="BtnCopyImei_Click" />
                </Grid>

                <!-- Eşleşen Çift SIM IMEI Satırı (Varsa) -->
                <Border x:Name="borderPairedImei"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="EŞLEŞEN ÇİFT SIM (2. IMEI)"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock x:Name="txtPairedImei"
                                       Text="354196091470722"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="#34D399"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="2. IMEI Kopyala"
                                Style="{DynamicResource TableActionButtonStyle}"
                                Height="26"
                                FontSize="11"
                                Padding="8,0"
                                VerticalAlignment="Center"
                                Click="BtnCopyPairedImei_Click" />
                    </Grid>
                </Border>

                <!-- Kaynak Cihaz / Model -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="KAYNAK MODEL:"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="txtBrandModel"
                               Text="Marka: GENERAL MOBILE Model: GM 5 PLUS T D"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Grid>

                <!-- BTK Durumu ve Son Kontrol -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="BTK DURUMU:"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="badgeStatusCategory"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="txtStatusCategory"
                                       Text="KAYITLI"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="10.5"
                                       FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="txtStatusDetails"
                                   Text="IMEI NUMARASI KAYITLI"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. KART: MÜŞTERİ, İŞLEM TARİHİ VE SERVİS NOTLARI          -->
        <!-- ========================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SubCardBackgroundBrush}"
                BorderBrush="{DynamicResource SubCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                Margin="0,0,0,18">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Müşteri Bilgisi -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="MÜŞTERİ ADI / İLETİŞİM"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="txtCustomer"
                                       Text="Repkon TG"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Takılan / Yüklenen Cihaz -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="İŞLEM YAPILAN CİHAZ"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="txtTargetDevice"
                                       Text="Redmi 13"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- İşlem Tarihi -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="İŞLEM TARİHİ:"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="txtUsedDate"
                               Text="26.10.2026 18:56:55"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Servis Notu -->
                <StackPanel>
                    <TextBlock Text="SERVİS &amp; İŞLEM NOTU"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,6" />
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            MinHeight="46">
                        <TextBlock x:Name="txtNote"
                                   Text="[SIM 1 - Eşleşen: 354196091470722]"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- 3. ALT AKSİYON BUTONLARI                                  -->
        <!-- ========================================================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Tüm Detayları Kopyala -->
            <Button Grid.Column="0"
                    Content="📋 Tüm Bilgileri Kopyala"
                    Style="{DynamicResource SecondaryActionButtonStyle}"
                    Height="36"
                    FontSize="12"
                    Padding="14,0"
                    Click="BtnCopyAllDetails_Click" />

            <!-- Bilgileri Düzenle -->
            <Button Grid.Column="2"
                    Content="Kayıt Düzenle"
                    Style="{DynamicResource SecondaryActionButtonStyle}"
                    Height="36"
                    FontSize="12"
                    Padding="14,0"
                    Margin="0,0,8,0"
                    Click="BtnEditDetails_Click" />

            <!-- Kapat -->
            <Button Grid.Column="3"
                    Content="Kapat"
                    Style="{DynamicResource PrimaryActionButtonStyle}"
                    Height="36"
                    FontSize="12.5"
                    Padding="22,0"
                    Click="BtnClose_Click" />
        </Grid>
    </Grid>
</Window>
