<Window x:Class="ImeiStudio.PinPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Güvenlik Doğrulaması"
        Icon="Assets/R_white_bg.png"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Background="#09090B"
        ui:TitleBar.Foreground="#FAFAFA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="borderHeaderIcon"
                    Grid.Column="0"
                    Width="42" Height="42"
                    CornerRadius="8"
                    Background="{DynamicResource SubCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <Path x:Name="pathHeaderIcon"
                      Data="{StaticResource GeoVault}"
                      Stroke="#10B981"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Width="17" Height="17"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="txtPromptTitle"
                           Text="PIN Kilidi Koruması"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="txtPromptSubtitle"
                           Text="Devam etmek için belirlediğiniz güvenlik PIN / şifresini girin."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- 1. NORMAL PIN GİRİŞ EKRANI -->
        <StackPanel x:Name="panelPinEntry" Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="GÜVENLİK PIN / PAROLA"
                       FontFamily="Cascadia Mono, Consolas, monospace"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,6" />
            <PasswordBox x:Name="pbPin"
                         Height="42"
                         FontSize="15"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         ui:ControlHelper.CornerRadius="7"
                         ui:ControlHelper.PlaceholderText="PIN kodunuzu girin..."
                         KeyDown="PbPin_KeyDown" />

            <TextBlock x:Name="txtError"
                       Text="Hatalı PIN kodu girdiniz. Lütfen tekrar deneyin."
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#F87171"
                       Margin="0,8,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- 2. ŞİFREMİ UNUTTUM (2x 10 SANİYE BEKLEMELİ SIFIRLAMA EKRANI) -->
        <StackPanel x:Name="panelForgotReset" Grid.Row="1" Margin="0,0,0,20" Visibility="Collapsed">
            <Border Background="#2A0A0E"
                    BorderBrush="#7F1D1D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtResetStageTitle"
                                   Grid.Column="0"
                                   Text="DİKKAT: TÜM VERİLER SİLİNECEKTİR"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#FCA5A5"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="#450A0A"
                                BorderBrush="#991B1B"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2">
                            <TextBlock x:Name="txtResetStepBadge"
                                       Text="ONAY 1 / 2"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#F87171" />
                        </Border>
                    </Grid>

                    <TextBlock x:Name="txtResetWarningBody"
                               Text="PIN kodunuzu unuttuysanız güvenlik nedeniyle şifre tek başına kaldırılamaz. Devam etmeniz halinde IMEI Kasasındaki tüm Kullanılabilir ve Kullanılan IMEI kayıtlarınız kalıcı olarak silinecek ve PIN kilidi kaldırılacaktır."
                               FontSize="12.5"
                               Foreground="#FECACA"
                               TextWrapping="Wrap"
                               LineHeight="18" />

                    <!-- Geri Sayım Çubuğu -->
                    <StackPanel Margin="0,12,0,2">
                        <Grid Margin="0,0,0,5">
                            <TextBlock x:Name="txtCountdownStatus"
                                       Text="Güvenlik bekleme süresi devam ediyor..."
                                       FontSize="11"
                                       Foreground="#FCA5A5" />
                            <TextBlock x:Name="txtCountdownSeconds"
                                       Text="10 sn"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#F87171"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar x:Name="pbCountdown"
                                     Minimum="0"
                                     Maximum="10"
                                     Value="0"
                                     Height="6"
                                     Foreground="#EF4444"
                                     Background="#450A0A" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="txtResetError"
                       Text=""
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#F87171"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- Alt Butonlar (Normal PIN Modu) -->
        <Grid x:Name="panelPinButtons" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Şifremi Unuttum"
                    Style="{StaticResource DangerActionButtonStyle}"
                    Height="38"
                    Padding="13,0"
                    Click="BtnForgotPin_Click" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Vazgeç"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Height="38"
                        Padding="16,0"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click" />

                <Button Content="Kilidi Aç"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Height="38"
                        Padding="18,0"
                        Click="BtnUnlock_Click" />
            </StackPanel>
        </Grid>

        <!-- Alt Butonlar (Şifremi Unuttum Modu) -->
        <Grid x:Name="panelResetButtons" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Geri Dön"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Height="38"
                    Padding="14,0"
                    Click="BtnBackToPin_Click" />

            <Button x:Name="btnConfirmResetStep"
                    Grid.Column="2"
                    Content="Lütfen Bekleyin (10 sn)..."
                    Style="{StaticResource DangerActionButtonStyle}"
                    Height="38"
                    Padding="16,0"
                    IsEnabled="False"
                    Click="BtnConfirmResetStep_Click" />
        </Grid>
    </Grid>
</Window>
