<Window x:Class="ImeiStudio.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Not Düzenle"
        Icon="Assets/R.png"
        Height="290" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık ve İkon -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="40" Height="40"
                    CornerRadius="10"
                    Background="{DynamicResource SubCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <TextBlock Text="✎"
                           FontSize="18"
                           Foreground="{DynamicResource AccentBlueBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Kayıt Notu Düzenle"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Bu IMEI için özel servis veya müşteri notunu güncelleyin."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Not Girişi -->
        <TextBox Grid.Row="1"
                 x:Name="txtNote"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 ui:ControlHelper.CornerRadius="8"
                 ui:ControlHelper.PlaceholderText="Not girin..."
                 FontSize="13"
                 Padding="10,8"
                 Margin="0,0,0,18" />

        <!-- Alt Butonlar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Vazgeç"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Height="38"
                    Padding="16,0"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click" />

            <Button Content="✓ Notu Kaydet"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Height="38"
                    Padding="18,0"
                    Click="BtnSave_Click" />
        </StackPanel>
    </Grid>
</Window>
