<Window x:Class="ImeiStudio.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Kullanım Detayı ve Not Düzenle"
        Icon="Assets/R_white_bg.png"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Background="#09090B"
        ui:TitleBar.Foreground="#FAFAFA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık ve Vektör İkon -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="40" Height="40"
                    CornerRadius="8"
                    Background="{DynamicResource SubCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <Path Data="{StaticResource GeoEdit}"
                      Stroke="{DynamicResource TextPrimaryBrush}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Width="16" Height="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Kullanım Detaylarını Düzenle"
                           FontSize="15.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Müşteri, işlem yapılan cihaz ve özel servis notunu güncelleyin."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Giriş Alanları -->
        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="MÜŞTERİ ADI / İLETİŞİM"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,5" />
                    <TextBox x:Name="txtCustomer"
                             Height="38"
                             ui:ControlHelper.CornerRadius="7"
                             ui:ControlHelper.PlaceholderText="Müşteri adı / tel..."
                             FontSize="13"
                             Padding="10,0"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="TAKILAN CİHAZ MODELİ"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,5" />
                    <TextBox x:Name="txtTargetDevice"
                             Height="38"
                             ui:ControlHelper.CornerRadius="7"
                             ui:ControlHelper.PlaceholderText="Takılan cihaz..."
                             FontSize="13"
                             Padding="10,0"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <TextBlock Text="ÖZEL SERVİS NOTU"
                       FontFamily="Cascadia Mono, Consolas, monospace"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,5" />
            <TextBox x:Name="txtNote"
                     Height="72"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     ui:ControlHelper.CornerRadius="7"
                     ui:ControlHelper.PlaceholderText="Not girin..."
                     FontSize="13"
                     Padding="10,8" />
        </StackPanel>

        <!-- Alt Butonlar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Vazgeç"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Height="38"
                    Padding="16,0"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click" />

            <Button Content="Değişiklikleri Kaydet"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Height="38"
                    Padding="18,0"
                    Click="BtnSave_Click" />
        </StackPanel>
    </Grid>
</Window>
