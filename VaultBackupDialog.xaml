<Window x:Class="ImeiStudio.VaultBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Kasa Yedekleri &amp; Otomatik Kurtarma"
        Icon="Assets/R_white_bg.png"
        Width="680"
        Height="630"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Background="#09090B"
        ui:TitleBar.Foreground="#FAFAFA">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <!-- 0: Başlık ve İkon -->
            <RowDefinition Height="Auto" />
            <!-- 1: Bilgi Kutusu & Yerel Eylemler -->
            <RowDefinition Height="Auto" />
            <!-- 2: Google Drive Bulut Entegrasyonu -->
            <RowDefinition Height="Auto" />
            <!-- 3: Yedek Dosyaları Listesi (DataGrid) -->
            <RowDefinition Height="*" />
            <!-- 4: Alt Butonlar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve İkon -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="42" Height="42"
                    CornerRadius="8"
                    Background="{DynamicResource SubCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <Path Data="{StaticResource GeoVault}"
                      Stroke="{DynamicResource TextPrimaryBrush}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Width="18" Height="18"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Kasa Yedekleri &amp; Otomatik Kurtarma"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Kasa verileriniz her işlemde otomatik olarak şifreli (.rfbak) olarak yedeklenir. İstediğiniz bir yedeği tek tıkla geri yükleyebilirsiniz."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- 1: Yerel Yedekleme Araç Çubuğu -->
        <Border Grid.Row="1"
                Background="{DynamicResource SubCardBackgroundBrush}"
                BorderBrush="{DynamicResource SubCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtBackupStats"
                               Text="Yedekler taranıyor..."
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="txtBackupPath"
                               Text="Konum: Belgelerim\Remofix_Backups"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 Şimdi Yedek Al"
                            Style="{DynamicResource SecondaryActionButtonStyle}"
                            Height="32"
                            FontSize="11.5"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Click="BtnCreateManualBackup_Click" />
                    <Button Content="📂 Yedek Klasörü"
                            Style="{DynamicResource SecondaryActionButtonStyle}"
                            Height="32"
                            FontSize="11.5"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            Click="BtnOpenBackupFolder_Click" />
                    <Button Content="Dosyadan Yükle..."
                            Style="{DynamicResource SecondaryActionButtonStyle}"
                            Height="32"
                            FontSize="11.5"
                            Padding="10,0"
                            Click="BtnBrowseBackupFile_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2: Google Drive Bulut Entegrasyonu Kartı -->
        <Border Grid.Row="2"
                Background="{DynamicResource SubCardBackgroundBrush}"
                BorderBrush="{DynamicResource SubCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36" Height="36"
                        CornerRadius="7"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoCloud}"
                          Stroke="#38BDF8"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="17" Height="17"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Google Drive Bulut Eşitleme"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border x:Name="borderDriveBadge"
                                CornerRadius="4"
                                Background="#1E293B"
                                Padding="6,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="txtDriveBadge"
                                       Text="BAĞLI DEĞİL"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="txtDriveStatus"
                               Text="Yedekler yalnızca bu bilgisayarda saklanıyor."
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chkDriveAutoUpload"
                              Content="Otomatik Yükle"
                              FontSize="11.5"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Checked="ChkDriveAutoUpload_Changed"
                              Unchecked="ChkDriveAutoUpload_Changed" />
                    <Button x:Name="btnDriveConnect"
                            Content="☁️ Google ile Bağlan"
                            Style="{DynamicResource SecondaryActionButtonStyle}"
                            Height="32"
                            FontSize="11.5"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            Click="BtnDriveConnect_Click" />
                    <Button x:Name="btnDriveBrowseCloud"
                            Content="Bulut Yedekleri"
                            Style="{DynamicResource SecondaryActionButtonStyle}"
                            Height="32"
                            FontSize="11.5"
                            Padding="10,0"
                            IsEnabled="False"
                            Click="BtnDriveBrowseCloud_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3: Yedekler Tablosu -->
        <Border Grid.Row="3"
                Style="{DynamicResource ModernCardStyle}"
                Padding="0"
                Margin="0,0,0,16">
            <DataGrid x:Name="dgBackups"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource DataGridGridLines}"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="42"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionChanged="dgBackups_SelectionChanged">
                <DataGrid.Columns>
                    <!-- Dosya Adı / Etiket -->
                    <DataGridTextColumn Header="YEDEK DOSYASI" Binding="{Binding FileName}" Width="*" ElementStyle="{DynamicResource DgPrimaryText}" />
                    <!-- Oluşturulma Tarihi -->
                    <DataGridTextColumn Header="TARİH &amp; SAAT" Binding="{Binding DisplayDate}" Width="150" ElementStyle="{DynamicResource DgMutedText}" />
                    <!-- İçerik Özeti -->
                    <DataGridTextColumn Header="DURUM / İÇERİK" Binding="{Binding DisplaySummary}" Width="200" ElementStyle="{DynamicResource DgSecondaryText}" />
                    <!-- Boyut -->
                    <DataGridTextColumn Header="BOYUT" Binding="{Binding DisplaySize}" Width="75" ElementStyle="{DynamicResource DgMutedText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4: Alt Aksiyon Butonları -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtSelectedSummary"
                       Grid.Column="0"
                       Text="Geri yüklemek istediğiniz yedeği yukarıdan seçin."
                       FontSize="11.5"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" />

            <Button x:Name="btnRestoreSelected"
                    Grid.Column="1"
                    Content="🔄 Bu Yedeği Geri Yükle"
                    Style="{DynamicResource PrimaryActionButtonStyle}"
                    Height="36"
                    FontSize="12"
                    Padding="16,0"
                    Margin="0,0,10,0"
                    IsEnabled="False"
                    Click="BtnRestoreSelected_Click" />

            <Button Grid.Column="2"
                    Content="Kapat"
                    Style="{DynamicResource SecondaryActionButtonStyle}"
                    Height="36"
                    FontSize="12"
                    Padding="20,0"
                    Click="BtnClose_Click" />
        </Grid>
    </Grid>
</Window>
