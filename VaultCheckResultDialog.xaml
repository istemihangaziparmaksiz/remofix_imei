<Window x:Class="ImeiStudio.VaultCheckResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="IMEI Kasası Kontrol Sonucu"
        Icon="Assets/R_white_bg.png"
        Width="495"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Background="#09090B"
        ui:TitleBar.Foreground="#FAFAFA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık ve Vektör İkon -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="44" Height="44"
                    CornerRadius="8"
                    Background="{DynamicResource SubCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <Path Data="{StaticResource GeoRefresh}"
                      Stroke="{DynamicResource TextPrimaryBrush}"
                      StrokeThickness="1.7"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Width="18" Height="18"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Kasa Kontrolü Tamamlandı"
                           FontSize="16.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Kullanılabilir kasadaki tüm IMEI numaralarının güncel durum özeti aşağıdadır."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <!-- Sonuç İstatistik Tablosu -->
        <Border Grid.Row="1"
                Background="{DynamicResource SubCardBackgroundBrush}"
                BorderBrush="{DynamicResource SubCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                Margin="0,0,0,18">
            <StackPanel>
                <!-- Toplam Kontrol Edilen -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="TOPLAM KONTROL EDİLEN"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="txtTotalCount"
                               Text="0 Adet"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,10" />

                <!-- Kayıtlı -->
                <Grid Margin="0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,10,0" />
                        <TextBlock Text="Kayıtlı (Sorunsuz)"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Background="{DynamicResource StatusSuccessBg}"
                            BorderBrush="{DynamicResource StatusSuccessBorder}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,2"
                            HorizontalAlignment="Right">
                        <TextBlock x:Name="txtRegisteredCount"
                                   Text="0 Adet"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource StatusSuccessText}" />
                    </Border>
                </Grid>

                <!-- Klonlanmış / Kopyalanmış -->
                <Grid Margin="0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" Margin="0,0,10,0" />
                        <TextBlock Text="Klonlanmış / Kopyalanmış"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Background="{DynamicResource StatusWarningBg}"
                            BorderBrush="{DynamicResource StatusWarningBorder}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,2"
                            HorizontalAlignment="Right">
                        <TextBlock x:Name="txtClonedCount"
                                   Text="0 Adet"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource StatusWarningText}" />
                    </Border>
                </Grid>

                <!-- Kayıt Dışı / Bulunamadı -->
                <Grid Margin="0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" Margin="0,0,10,0" />
                        <TextBlock Text="Kayıt Dışı / Kayıtsız"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Background="{DynamicResource StatusDangerBg}"
                            BorderBrush="{DynamicResource StatusDangerBorder}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,2"
                            HorizontalAlignment="Right">
                        <TextBlock x:Name="txtUnregisteredCount"
                                   Text="0 Adet"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource StatusDangerText}" />
                    </Border>
                </Grid>

                <!-- Kapatılmış (Savcılık / Sinyal Yok / Diğer) -->
                <Grid Margin="0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#71717A" Margin="0,0,10,0" />
                        <TextBlock Text="Kapatılmış (Savcılık / 1-7 Yıl Sinyal Yok)"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,2"
                            HorizontalAlignment="Right">
                        <TextBlock x:Name="txtClosedCount"
                                   Text="0 Adet"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </Grid>

                <!-- Sorgu Hatası (Sadece hata varsa görünür) -->
                <Grid x:Name="rowErrorCount" Margin="0,4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#F87171" Margin="0,0,10,0" />
                        <TextBlock Text="Sorgu Hatası / Kontrol Edilemeyen"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Background="{DynamicResource StatusDangerBg}"
                            BorderBrush="{DynamicResource StatusDangerBorder}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,2"
                            HorizontalAlignment="Right">
                        <TextBlock x:Name="txtErrorCount"
                                   Text="0 Adet"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource StatusDangerText}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Seçenek Açıklaması -->
        <TextBlock Grid.Row="2"
                   Text="Kontrol sonrasında IMEI Kasası listesi için hangi işlemi uygulamak istersiniz?"
                   FontSize="12.5"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap" />

        <!-- Alt Eylem Butonları: 1) Olduğu Gibi Bırak, 2) Kayıtlı IMEI Numaraları Kalsın -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Olduğu Gibi Bırak"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Height="40"
                    Padding="16,0"
                    Click="BtnLeaveAsIs_Click" />

            <Button Grid.Column="2"
                    Content="Kayıtlı IMEI Numaraları Kalsın"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Height="40"
                    Padding="18,0"
                    Click="BtnKeepOnlyRegistered_Click" />
        </Grid>
    </Grid>
</Window>
