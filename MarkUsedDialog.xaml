<Window x:Class="ImeiStudio.MarkUsedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Kullanıldı Olarak İşaretle"
        Icon="Assets/R.png"
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık ve İkon -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="44" Height="44"
                    CornerRadius="10"
                    Background="{DynamicResource StatusSuccessBg}"
                    BorderBrush="{DynamicResource StatusSuccessBorder}"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <TextBlock Text="✓"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource StatusSuccessText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Kullanıldı Olarak İşaretle"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Bu kayıt 'Kullanılanlar' listesine aktarılacaktır. İsteğe bağlı not ekleyebilirsiniz."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- IMEI & Model Özet Kartı -->
        <Border Grid.Row="1"
                Background="{DynamicResource SubCardBackgroundBrush}"
                BorderBrush="{DynamicResource SubCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="txtImei"
                               Text="354196091468064"
                               FontFamily="Consolas, monospace"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlueBrush}" />
                    <TextBlock x:Name="txtModel"
                               Text="Model: Belirtilmemiş"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource StatusSuccessBg}"
                        BorderBrush="{DynamicResource StatusSuccessBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="KAYITLI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessText}" />
                </Border>
            </Grid>
        </Border>

        <!-- Not Girişi -->
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Cihaz / Müşteri Notu (Opsiyonel):"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,6" />

            <TextBox Grid.Row="1"
                     x:Name="txtNote"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     ui:ControlHelper.CornerRadius="8"
                     ui:ControlHelper.PlaceholderText="Örn: Ahmet Bey - Anakart Değişimi, Servis #104..."
                     FontSize="13"
                     Padding="10,8" />
        </Grid>

        <!-- Alt Butonlar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Vazgeç"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Height="38"
                    Padding="16,0"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click" />

            <Button Content="✓ Kullanıldı Olarak Kaydet"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Height="38"
                    Padding="18,0"
                    Click="BtnConfirm_Click" />
        </StackPanel>
    </Grid>
</Window>
