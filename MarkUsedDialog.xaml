<Window x:Class="ImeiStudio.MarkUsedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Kullanıldı Olarak İşaretle"
        Icon="Assets/R_white_bg.png"
        Width="510"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Background="#09090B"
        ui:TitleBar.Foreground="#FAFAFA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık ve Vektör İkon -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="42" Height="42"
                    CornerRadius="8"
                    Background="{DynamicResource StatusSuccessBg}"
                    BorderBrush="{DynamicResource StatusSuccessBorder}"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <Path Data="{StaticResource GeoCheck}"
                      Stroke="{DynamicResource StatusSuccessText}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Width="17" Height="17"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="txtDialogTitle"
                           Text="Kullanıldı Olarak İşaretle"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="txtDialogSubtitle"
                           Text="Müşteri, işlem yapılan cihaz ve servis notu bilgilerini girerek kullanılanlara aktarın."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- IMEI & Çift SIM Özet Kartı -->
        <Border Grid.Row="1"
                Background="{DynamicResource SubCardBackgroundBrush}"
                BorderBrush="{DynamicResource SubCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- SIM 1 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="badgeSim1"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1"
                                Margin="0,0,8,0"
                                Visibility="Collapsed">
                            <TextBlock Text="SIM 1" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                        </Border>
                        <TextBlock x:Name="txtImei"
                                   Text="354196091468064"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="txtModel"
                               Text="Model: Belirtilmemiş"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />

                    <!-- SIM 2 (Sadece Çift SIM modunda görünür) -->
                    <StackPanel x:Name="panelSim2" Margin="0,10,0,0" Visibility="Collapsed">
                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="0,0,8,0">
                                <TextBlock Text="SIM 2" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                            </Border>
                            <TextBlock x:Name="txtImei2"
                                       Text="354196091468072"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="txtModel2"
                                   Text="Model: Belirtilmemiş"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Kopyala Butonu -->
                <Button Grid.Column="1"
                        x:Name="btnQuickCopy"
                        Content="Kopyala"
                        Style="{StaticResource TableActionButtonStyle}"
                        Height="32"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Click="BtnQuickCopy_Click" />
            </Grid>
        </Border>

        <!-- Detaylı Kullanım Kaydı Alanları -->
        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="MÜŞTERİ ADI / İLETİŞİM"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,5" />
                    <TextBox x:Name="txtCustomer"
                             Height="38"
                             ui:ControlHelper.CornerRadius="7"
                             ui:ControlHelper.PlaceholderText="Örn: Ahmet Yılmaz (0532...)"
                             FontSize="13"
                             Padding="10,0"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="İŞLEM YAPILAN (TAKILAN) CİHAZ"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,5" />
                    <TextBox x:Name="txtTargetDevice"
                             Height="38"
                             ui:ControlHelper.CornerRadius="7"
                             ui:ControlHelper.PlaceholderText="Örn: Redmi Note 12 Pro"
                             FontSize="13"
                             Padding="10,0"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <TextBlock Text="EK SERVİS NOTU (OPSİYONEL)"
                       FontFamily="Cascadia Mono, Consolas, monospace"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,5" />
            <TextBox x:Name="txtNote"
                     Height="68"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     ui:ControlHelper.CornerRadius="7"
                     ui:ControlHelper.PlaceholderText="Örn: Çift hat direnç işlemi yapıldı, garanti 6 ay..."
                     FontSize="13"
                     Padding="10,8" />
        </StackPanel>

        <!-- Alt Butonlar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Vazgeç"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Height="38"
                    Padding="16,0"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click" />

            <Button x:Name="btnConfirm"
                    Content="Kullanıldı Olarak Kaydet"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Height="38"
                    Padding="18,0"
                    Click="BtnConfirm_Click" />
        </StackPanel>
    </Grid>
</Window>
